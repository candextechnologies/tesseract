<?xml version="1.0" encoding="utf-8"?>
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <!-- This defines the root directory of the package's build assets -->
    <TesseractPackageRoot>$(MSBuildThisFileDirectory)</TesseractPackageRoot>
  </PropertyGroup>

  <!--
    This ItemGroup unconditionally adds all files from the x86, x64, and arm64 folders
    as linked content to the project. The build system will then copy them to the
    output directory while preserving their folder structure.
  -->
  <ItemGroup>
    <Content Include="$(TesseractPackageRoot)x86\**\*.*">
      <Link>x86\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Visible>false</Visible>
    </Content>
    <Content Include="$(TesseractPackageRoot)x64\**\*.*">
      <Link>x64\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Visible>false</Visible>
    </Content>
    <Content Include="$(TesseractPackageRoot)arm64\**\*.*">
      <Link>arm64\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Visible>false</Visible>
    </Content>
  </ItemGroup>

  <!-- 
    This target will run before the main build step. It defines the items to be copied
    and then performs the copy operation. This is the most reliable method.
  -->
  <Target Name="CopyTesseractNativeBinaries" BeforeTargets="Build">
    
    <!-- Define the source files for each platform -->
    <ItemGroup>
      <TesseractX86Files Include="$(TesseractPackageRoot)x86\**\*.*" />
      <TesseractX64Files Include="$(TesseractPackageRoot)x64\**\*.*" />
      <TesseractArm64Files Include="$(TesseractPackageRoot)arm64\**\*.*" />
    </ItemGroup>

    <!-- 
      Copy the files to the output directory, preserving the subfolder structure.
      The Destination is calculated relative to the final output directory ($(OutDir)).
    -->
    <Copy
        SourceFiles="@(TesseractX86Files)"
        DestinationFiles="@(TesseractX86Files->'$(OutDir)x86\%(RecursiveDir)%(Filename)%(Extension)')"
        SkipUnchangedFiles="true"
        />
        
    <Copy
        SourceFiles="@(TesseractX64Files)"
        DestinationFiles="@(TesseractX64Files->'$(OutDir)x64\%(RecursiveDir)%(Filename)%(Extension)')"
        SkipUnchangedFiles="true"
        />
        
    <Copy
        SourceFiles="@(TesseractArm64Files)"
        DestinationFiles="@(TesseractArm64Files->'$(OutDir)arm64\%(RecursiveDir)%(Filename)%(Extension)')"
        SkipUnchangedFiles="true"
        />
  </Target>
</Project>